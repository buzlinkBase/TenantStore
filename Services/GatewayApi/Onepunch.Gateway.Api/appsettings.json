{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthUrl": "http://auth-api:8080",
  "Domains": {
    "TenantUrl": "http://tenant-api:8080"
  },
  "JwtSettings": {
    "Issuer": "Onepunch",
    "Audience": "Onepunch.AuthService"
  },
  "ConnectionStrings": {
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "tenant-route": {
        "ClusterId": "tenant-cluster",
        "Match": {
          "Path": "/tenant/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tenant" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api:8080"
          }
        }
      },
      "tenant-cluster": {
        "Destinations": {
          "tenant-api": {
            "Address": "http://tenant-api:8080"
          }
        }
      }
    }
  }
}
