{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Subscriptions": {
    "EnforcementEnabled": true,
    "TrialDays": 7,
    "GraceDays": 7,
    "PurgeAfterDays": 365,
    "LegacyPlanCode": "legacy-free-trial",
    "LegacyPeriodEndUtc": null,
    "LifecycleCron": "0 0 * * * ?",
    "SchedulerEnabled": true,
    "Usage": {
      "HrmsApiUrl": "",
      "HrmsApiKey": "",
      "AdmsApiUrl": "",
      "AdmsApiKey": ""
    }
  },
  "Platform": {
    "ApiKey": ""
  },
  "Payments": {
    "ReturnBaseUrl": "",
    "ProductName": "One Punch HRIS",
    "PayMongo": {
      "ApiBaseUrl": "https://api.paymongo.com/v1/",
      "SecretKey": "",
      "WebhookSecret": "",
      "PaymentMethodTypes": [ "card", "gcash", "paymaya", "qrph" ],
      "StatementDescriptor": null
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Exceptions", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "Loki": {
        "Name": "GrafanaLoki",
        "Args": {
          "queueLimit": 10000,
          "batchPostingLimit": 1000,
          "uri": "http://loki:3100",
          "labels": [
            { "key": "app", "value": "tenantstore-api" },
            { "key": "system", "value": "tenantstore" }
          ]
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Project": "tenantstore-api",
      "System": "tenantstore"
    }
  }
}
