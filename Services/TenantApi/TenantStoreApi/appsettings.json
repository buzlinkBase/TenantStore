{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Subscriptions": {
    "EnforcementEnabled": true,
    "TrialDays": 7,
    "GraceDays": 7,
    "PurgeAfterDays": 90,
    "LegacyPlanCode": "premium",
    "LegacyPeriodEndUtc": null,
    "Usage": {
      "HrmsApiUrl": "",
      "HrmsApiKey": "",
      "AdmsApiUrl": "",
      "AdmsApiKey": ""
    }
  },
  "Platform": {
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Exceptions", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "Loki": {
        "Name": "GrafanaLoki",
        "Args": {
          "queueLimit": 10000,
          "batchPostingLimit": 1000,
          "uri": "http://loki:3100",
          "labels": [
            { "key": "app", "value": "tenantstore-api" },
            { "key": "system", "value": "tenantstore" }
          ]
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Project": "tenantstore-api",
      "System": "tenantstore"
    }
  }
}
