{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotifConnection": "",
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "Serilog": {
    "Using": [ "Serilog.Exceptions", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "Loki": {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            { "key": "app", "value": "notification-api" },
            { "key": "system", "value": "notification" }
          ]
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName",
      "WithProcessId",
      "WithProcessName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Project": "notification-api",
      "System": "notification"
    }
  }
}
